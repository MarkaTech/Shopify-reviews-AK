# ─────────────────────────────────────────────────────────────────────────────
# ReviewMaster — environment variables
# Copy to .env for local development. Never commit the real .env.
# In production these are set as Azure Web App application settings.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
#
# IMPORTANT: any of : / ? # [ ] @ in the password MUST be percent-encoded, or the URL
# is invalid and Prisma refuses to connect. # is the one that bites most often —
# it starts a URL fragment. Encode it as %23.
#   password  Rm14...oBR7Y#7x
#   in URL    Rm14...oBR7Y%237x
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/reviewmaster?sslmode=require"

# ── Shopify app credentials (Partner Dashboard > App setup) ──
# Client ID. Public — it is rendered into the page as the App Bridge meta tag and appears
# in every OAuth URL. Either name is read; SHOPIFY_API_KEY is preferred for new setups,
# NEXT_PUBLIC_SHOPIFY_API_KEY is kept working for deployments that already set it.
SHOPIFY_API_KEY=""

# Client secret. Used for OAuth token exchange and every HMAC check. Never expose.
SHOPIFY_API_SECRET=""

# Full HTTPS base URL of the deployed app. Must exactly match the OAuth redirect
# URLs configured in the Partner Dashboard.
SHOPIFY_APP_URL="https://reviewmaster-app.azurewebsites.net"

# ── Secrets ──
# Signs session cookies. Minimum 32 characters.
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# Encrypts Shopify access tokens at rest (AES-256-GCM). Minimum 32 characters.
# Falls back to NEXTAUTH_SECRET if unset, but a separate key is strongly preferred:
# rotating your cookie secret should not make every stored token undecryptable.
#   openssl rand -base64 32
#
# WARNING: changing this after tokens are stored makes them unrecoverable and every
# merchant must reinstall. Store it somewhere durable before going live.
TOKEN_ENCRYPTION_KEY=""

NODE_ENV="development"

# ── Transactional email (review request emails) ──
# Amazon SES (preferred at volume — cheapest per email, you manage reputation).
# The IAM user needs only the ses:SendEmail permission.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_REGION="us-east-1"

# Configure ONE provider. Without either, review requests are still created and their
# links still work — they just have to be shared manually.
#
# https://resend.com — simplest to set up; free tier covers early usage.
RESEND_API_KEY=""
# https://sendgrid.com — alternative.
SENDGRID_API_KEY=""

# The From address. The domain must be verified with your provider or mail will bounce.
#   e.g. "ReviewMaster <reviews@yourdomain.com>"
EMAIL_FROM=""
